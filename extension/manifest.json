{
  "manifest_version": 3,
  "name": "OGVPN — Secure Proxy",
  "version": "1.1.3",
  "description": "Browser-only secure proxy from OGVPN. Minimal permissions, account sync, one-click location switching.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "proxy", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["https://api.aegisvpn.io/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
